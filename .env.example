# Copy to .env and fill in. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the chat models (Flash-Lite has the highest free daily limit, ~500 requests/day per model)
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite   (or gemini-flash-lite-latest)
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional: much faster assistant chat via Groq (free key at https://console.groq.com/keys)
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b   (default; tried in order, each must support tool use)
