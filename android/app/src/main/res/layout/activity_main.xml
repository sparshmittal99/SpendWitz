<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Page load progress, just under the status bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:visibility="gone"
        app:indicatorColor="@color/brand"
        app:trackColor="@android:color/transparent"
        app:trackThickness="3dp" />

    <!-- Shown when the server can't be reached -->
    <LinearLayout
        android:id="@+id/offlineView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_tile"
            android:importantForAccessibility="no"
            android:padding="16dp"
            android:src="@drawable/ic_cloud_off"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/offlineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/offline_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/offlineMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="360dp"
            android:text="@string/offline_message"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/brand"
            android:text="@string/retry"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Starting screen: logo and name, shown for about 1.2 seconds on launch (see MainActivity.playIntro) -->
    <LinearLayout
        android:id="@+id/introView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/brand"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <ImageView
            android:id="@+id/introLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:importantForAccessibility="no"
            android:src="@drawable/intro_wallet" />

        <TextView
            android:id="@+id/introName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/introTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/intro_tagline"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
