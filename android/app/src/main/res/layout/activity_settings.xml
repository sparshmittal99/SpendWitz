<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationContentDescription="Back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/settings_title"
        app:titleTextColor="?attr/colorOnSurface" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="640dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- Appearance -->
            <TextView
                style="@style/Settings.Section"
                android:text="@string/section_appearance" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:id="@+id/rowDarkMode"
                    style="@style/Settings.Row">

                    <ImageView
                        style="@style/Settings.Icon"
                        android:src="@drawable/ic_dark_mode" />

                    <LinearLayout style="@style/Settings.Texts">

                        <TextView
                            style="@style/Settings.Title"
                            android:text="@string/dark_mode" />

                        <TextView
                            style="@style/Settings.Subtitle"
                            android:text="@string/dark_mode_hint" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/dark_mode" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notifications -->
            <TextView
                style="@style/Settings.Section"
                android:text="@string/section_notifications" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowBudgetAlerts"
                        style="@style/Settings.Row">

                        <ImageView
                            style="@style/Settings.Icon"
                            android:src="@drawable/ic_notifications" />

                        <LinearLayout style="@style/Settings.Texts">

                            <TextView
                                style="@style/Settings.Title"
                                android:text="@string/budget_alerts" />

                            <TextView
                                style="@style/Settings.Subtitle"
                                android:text="@string/budget_alerts_hint" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchBudgetAlerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:contentDescription="@string/budget_alerts" />
                    </LinearLayout>

                    <View style="@style/Settings.Divider" />

                    <LinearLayout
                        android:id="@+id/rowCheckNow"
                        style="@style/Settings.Row">

                        <ImageView
                            style="@style/Settings.Icon"
                            android:src="@drawable/ic_fact_check" />

                        <LinearLayout style="@style/Settings.Texts">

                            <TextView
                                style="@style/Settings.Title"
                                android:text="@string/check_now" />

                            <TextView
                                style="@style/Settings.Subtitle"
                                android:text="@string/check_now_hint" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Photos -->
            <TextView
                style="@style/Settings.Section"
                android:text="@string/section_photos" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    style="@style/Settings.Row"
                    android:background="@null"
                    android:clickable="false"
                    android:focusable="false">

                    <ImageView
                        style="@style/Settings.Icon"
                        android:src="@drawable/ic_compress" />

                    <LinearLayout style="@style/Settings.Texts">

                        <TextView
                            style="@style/Settings.Title"
                            android:text="@string/photo_compression" />

                        <TextView
                            style="@style/Settings.Subtitle"
                            android:text="@string/photo_compression_hint" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About -->
            <TextView
                style="@style/Settings.Section"
                android:text="@string/section_about" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/Settings.Row"
                        android:background="@null"
                        android:clickable="false"
                        android:focusable="false">

                        <ImageView
                            style="@style/Settings.Icon"
                            android:src="@drawable/ic_info" />

                        <LinearLayout style="@style/Settings.Texts">

                            <TextView
                                style="@style/Settings.Title"
                                android:text="@string/version" />

                            <TextView
                                android:id="@+id/versionText"
                                style="@style/Settings.Subtitle" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/Settings.Divider" />

                    <LinearLayout
                        style="@style/Settings.Row"
                        android:background="@null"
                        android:clickable="false"
                        android:focusable="false">

                        <ImageView
                            style="@style/Settings.Icon"
                            android:src="@drawable/ic_language" />

                        <LinearLayout style="@style/Settings.Texts">

                            <TextView
                                style="@style/Settings.Title"
                                android:text="@string/server" />

                            <TextView
                                android:id="@+id/serverText"
                                style="@style/Settings.Subtitle" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- The web footer's notice, shown here in the app -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_notice"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/notice_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/notice_title"
                        android:textAllCaps="true"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/notice_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notice_1"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/notice_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notice_2"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/notice_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notice_3"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/notice_text" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
