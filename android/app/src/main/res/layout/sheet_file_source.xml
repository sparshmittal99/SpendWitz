<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="@string/sheet_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:id="@+id/optionCamera"
        style="@style/Sheet.Option">

        <ImageView
            style="@style/Sheet.OptionIcon"
            android:src="@drawable/ic_camera" />

        <LinearLayout style="@style/Settings.Texts">

            <TextView
                style="@style/Settings.Title"
                android:text="@string/option_camera" />

            <TextView
                style="@style/Settings.Subtitle"
                android:text="@string/option_camera_hint" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionGallery"
        style="@style/Sheet.Option">

        <ImageView
            style="@style/Sheet.OptionIcon"
            android:src="@drawable/ic_photo_library" />

        <LinearLayout style="@style/Settings.Texts">

            <TextView
                style="@style/Settings.Title"
                android:text="@string/option_gallery" />

            <TextView
                style="@style/Settings.Subtitle"
                android:text="@string/option_gallery_hint" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionFiles"
        style="@style/Sheet.Option">

        <ImageView
            style="@style/Sheet.OptionIcon"
            android:src="@drawable/ic_folder" />

        <LinearLayout style="@style/Settings.Texts">

            <TextView
                style="@style/Settings.Title"
                android:text="@string/option_files" />

            <TextView
                style="@style/Settings.Subtitle"
                android:text="@string/option_files_hint" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
